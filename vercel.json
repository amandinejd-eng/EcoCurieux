{
  "version": 2,
  "cleanUrls": false,
  "rewrites": [
    { "source": "/lib/oauth-credentials.json", "destination": "/api/github-webhook" },
    { "source": "/auth", "destination": "/api/auth" },
    { "source": "/callback", "destination": "/api/callback" },
    { "source": "/github-setup", "destination": "/api/github-setup" },
    { "source": "/p/:slug", "destination": "/page.html" },
    { "source": "/p/:slug/", "destination": "/page.html" }
  ],
  "headers": [
    {
      "source": "/evenements.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/contenu/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/js/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
